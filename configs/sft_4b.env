# 16GB 卡，或 9B 在 24GB 上 OOM 时用这套。任务相同，只是基座换成 Qwen3.5-4B。
MODEL=Qwen/Qwen3.5-4B
MODEL_AUTHOR=intranet
MODEL_NAME=ticket-analyst

DATA_CASES=data/example/cases
DATA_GOLD=data/example/gold
DATA_OUT=data/processed
OUTPUT_DIR=output/sft_4b

TORCH_DTYPE=bfloat16
LORA_RANK=8
LORA_ALPHA=32
TARGET_MODULES=all-linear
LEARNING_RATE=1e-4
NUM_TRAIN_EPOCHS=3
MAX_STEPS=
PER_DEVICE_BATCH=1
GRAD_ACCUM=8
MAX_LENGTH=4096
WARMUP_RATIO=0.05
LOGGING_STEPS=1
SAVE_STEPS=50
EVAL_STEPS=50
SAVE_TOTAL_LIMIT=3
SEED=42

FREEZE_VIT=true
ADD_NON_THINKING_PREFIX=true
LOSS_SCALE=ignore_empty_think
GRADIENT_CHECKPOINTING=true
NPROC_PER_NODE=1
DATASET_NUM_PROC=1
DATALOADER_NUM_WORKERS=0
