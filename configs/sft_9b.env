# Qwen3.5-9B，bf16 LoRA。24GB 单卡是起点。
# 不默认开 4bit：Qwen3.5 的 QLoRA 数值误差比常见模型大。显存不够就换 configs/sft_4b.env。
MODEL=Qwen/Qwen3.5-9B
MODEL_AUTHOR=intranet
MODEL_NAME=ticket-analyst

DATA_CASES=data/example/cases
DATA_GOLD=data/example/gold
DATA_OUT=data/processed
OUTPUT_DIR=output/sft_9b

TORCH_DTYPE=bfloat16
LORA_RANK=8
LORA_ALPHA=32
TARGET_MODULES=all-linear
LEARNING_RATE=1e-4
NUM_TRAIN_EPOCHS=3
MAX_STEPS=
PER_DEVICE_BATCH=1
GRAD_ACCUM=8
MAX_LENGTH=4096
WARMUP_RATIO=0.05
LOGGING_STEPS=1
SAVE_STEPS=50
EVAL_STEPS=50
SAVE_TOTAL_LIMIT=3
SEED=42

FREEZE_VIT=true
ADD_NON_THINKING_PREFIX=true
LOSS_SCALE=ignore_empty_think
GRADIENT_CHECKPOINTING=true
NPROC_PER_NODE=1
DATASET_NUM_PROC=1
DATALOADER_NUM_WORKERS=0

# 训得太慢再打开，并先装 flash-attn。取值用 swift sft -h 里看到的那个。
# ATTN_IMPL=flash_attn
